# =================================================================
# IntentCart Backend Environment Configuration Template
# =================================================================

# Groq API Key for 120B / Llama 3 Tool Calling Agent
GROQ_API_KEY=gsk_your_groq_api_key_here

# PayPal REST API Sandbox Credentials
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_secret
PAYPAL_MODE=sandbox

# Set to True for frictionless, login-free mock testing (ideal for regions where PayPal sandbox logins are IP-restricted)
# Set to False to hit live PayPal developer sandbox servers
PAYPAL_USE_MOCK=True
